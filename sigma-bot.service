[Unit]
Description=Sigma Project Native Go Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sigma-bot
ExecStart=/home/ubuntu/sigma-bot/bot-sigma-linux
Restart=always
RestartSec=5
LimitNOFILE=65535
Environment=PORT=3002

[Install]
WantedBy=multi-user.target
